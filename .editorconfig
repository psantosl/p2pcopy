root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,props,csproj,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Vendored UdtSharp keeps its upstream style.
[src/p2pcopy/Udt/**.cs]
dotnet_analyzer_diagnostic.severity = none
